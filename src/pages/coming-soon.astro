---
import { Image } from 'astro:assets';
import { siteConfig } from '@data/config';
import carnivalImage from '../assets/images/carnival/slide-carnival.jpg';
import pirateShipImage from '../assets/images/carnival/pirate-ship.jpg';
import raffleTicketsPhoto from '../assets/images/carnival/jeep-raffle.jpg';
import rafflePromo from '../assets/images/carnival/raffle-promo.png';
import { Ticket, Trophy, UtensilsCrossed, Grid3x3, Heart, MapPin, CalendarDays, Clock, Facebook, Target, CircleParking } from 'lucide-astro';

const raffleUrl = 'https://givebutter.com/2026-evfc1-jeep-raffle-copy-r5mjxx';

const features = [
    {
        title: 'Rides',
        description: 'Fun rides for all ages, from kiddie classics to midway thrillers.',
        icon: Ticket
    },
    {
        title: 'Games & Prizes',
        description: 'Classic carnival games where you can test your skills and win prizes for the whole family.',
        icon: Trophy
    },
    {
        title: 'Food & Refreshments',
        description: 'Delicious carnival favorites including fried dough, cotton candy, burgers, and more.',
        icon: UtensilsCrossed
    },
    {
        title: 'Bingo',
        description: 'Fast, fun and a great time! Join us for exciting bingo games with prizes.',
        icon: Grid3x3
    },
    {
        title: 'Dunk Tank',
        description: 'Grab a ball, take aim, and do your best to send someone into the drink!',
        icon: Target
    },
    {
        title: 'Free Parking',
        description: 'Park for free right on the carnival grounds — easy in, easy out, every night.',
        icon: CircleParking
    },
    {
        title: 'Community Spirit',
        description: 'Connect with neighbors and support your local volunteer fire company.',
        icon: Heart
    }
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Annual Carnival · July 28 – Aug 1, 2026 | Easton Volunteer Fire Company #1</title>
    <meta name="description" content="The Easton Volunteer Fire Company Annual Carnival returns July 28 – August 1, 2026, 6–11 PM nightly at 1 Center Road, Easton CT. Rides, games, food, bingo — and the 2026 Jeep Raffle!" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rye&family=Staatliches&family=Cabin:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --night: #171009;
            --night-2: #211710;
            --panel: #2a1d13;
            --cream: #f6ecd7;
            --cream-dim: #d8c9a8;
            --red: #c8102e;
            --red-bright: #e6203f;
            --gold: #f0a72c;
            --gold-soft: #ffd77a;
            --line: rgba(240, 167, 44, 0.28);
            --font-display: 'Rye', 'Georgia', serif;
            --font-poster: 'Staatliches', 'Impact', sans-serif;
            --font-body: 'Cabin', 'Trebuchet MS', sans-serif;
        }

        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-body);
            background: var(--night);
            color: var(--cream);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3 { line-height: 1.1; text-wrap: balance; }
        img { max-width: 100%; height: auto; display: block; }
        a { color: inherit; }

        .eyebrow {
            font-family: var(--font-poster);
            letter-spacing: 0.24em;
            font-size: clamp(0.9rem, 2.5vw, 1.15rem);
            color: var(--gold);
            text-transform: uppercase;
        }

        .wrap { width: min(1100px, 92vw); margin-inline: auto; }

        /* ---- marquee bulb strips ---- */
        .bulbs {
            height: 18px;
            background-image: radial-gradient(circle at 9px 9px, var(--gold-soft) 0 3.5px, rgba(240, 167, 44, 0.35) 4.5px, transparent 6.5px);
            background-size: 36px 18px;
            background-repeat: repeat-x;
            animation: bulb-chase 1.1s steps(1) infinite;
        }
        @keyframes bulb-chase { 50% { background-position-x: 18px; } }

        /* ---- buttons ---- */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            font-family: var(--font-poster);
            font-size: clamp(1.05rem, 2.6vw, 1.3rem);
            letter-spacing: 0.09em;
            text-transform: uppercase;
            text-decoration: none;
            padding: 0.8rem 1.7rem;
            border: 2px solid var(--night);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-red {
            background: var(--red);
            color: var(--cream);
            border-color: rgba(0, 0, 0, 0.35);
            box-shadow: 5px 5px 0 var(--gold);
        }
        .btn-red:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--gold); }
        .btn-ghost {
            background: transparent;
            color: var(--cream);
            border: 2px solid var(--line);
            box-shadow: none;
        }
        .btn-ghost:hover { border-color: var(--gold); color: var(--gold-soft); transform: translateY(-2px); }

        /* ---- reveal on scroll (only hidden when JS is running) ---- */
        html.js [data-reveal] {
            opacity: 0;
            transform: translateY(26px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        html.js [data-reveal].in { opacity: 1; transform: none; }

        /* =========== HERO =========== */
        .hero {
            position: relative;
            min-height: 100svh;
            display: grid;
            place-items: center;
            text-align: center;
            padding: 4rem 1rem 5rem;
            isolation: isolate;
        }
        .hero-bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
        }
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background:
                radial-gradient(ellipse at 50% 20%, rgba(200, 16, 46, 0.28), transparent 55%),
                linear-gradient(180deg, rgba(23, 16, 9, 0.72) 0%, rgba(23, 16, 9, 0.55) 45%, rgba(23, 16, 9, 0.94) 88%, var(--night) 100%);
        }
        .hero-inner { max-width: 60rem; }
        .hero .eyebrow { display: block; margin-bottom: 1rem; animation: drop-in 0.8s ease both; }
        .hero h1 {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: clamp(3rem, 11vw, 7rem);
            color: var(--cream);
            text-shadow: 3px 3px 0 var(--red), 6px 6px 0 rgba(0, 0, 0, 0.45);
            animation: drop-in 0.8s 0.12s ease both;
        }
        .hero-year {
            font-family: var(--font-poster);
            font-size: clamp(1.4rem, 4vw, 2rem);
            letter-spacing: 0.5em;
            margin-left: 0.5em; /* optically re-center the tracked-out text */
            color: var(--gold-soft);
            margin-top: 0.4rem;
            animation: drop-in 0.8s 0.2s ease both;
        }
        @keyframes drop-in {
            from { opacity: 0; transform: translateY(-22px); }
            to { opacity: 1; transform: none; }
        }

        /* ticket-stub date badge */
        .date-ticket {
            position: relative;
            display: inline-block;
            background: var(--cream);
            color: var(--night);
            margin-top: 2.2rem;
            padding: 1rem 2.4rem;
            transform: rotate(-1.5deg);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
            animation: drop-in 0.8s 0.3s ease both;
        }
        .date-ticket::before {
            content: '';
            position: absolute;
            inset: 6px;
            border: 2px dashed rgba(23, 16, 9, 0.35);
            pointer-events: none;
        }
        .date-ticket::after {
            content: '';
            position: absolute;
            top: 50%;
            left: -9px;
            width: calc(100% + 18px);
            height: 18px;
            transform: translateY(-50%);
            background:
                radial-gradient(circle 9px at 9px 50%, var(--night) 97%, transparent) left center / 18px 18px no-repeat,
                radial-gradient(circle 9px at 9px 50%, var(--night) 97%, transparent) right center / 18px 18px no-repeat;
            pointer-events: none;
        }
        .date-ticket .dt-days {
            font-family: var(--font-poster);
            font-size: clamp(1.5rem, 4.5vw, 2.3rem);
            letter-spacing: 0.06em;
            color: var(--red);
        }
        .date-ticket .dt-hours {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            font-weight: 700;
            font-size: clamp(0.95rem, 2.8vw, 1.15rem);
            letter-spacing: 0.04em;
        }
        .hero-place {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            margin-top: 1.6rem;
            color: var(--cream-dim);
            font-size: 1.05rem;
            animation: drop-in 0.8s 0.4s ease both;
        }
        .hero-ctas {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            margin-top: 2.2rem;
            animation: drop-in 0.8s 0.5s ease both;
        }

        /* =========== COUNTDOWN =========== */
        .countdown {
            position: relative;
            background:
                radial-gradient(ellipse at 50% 0%, rgba(240, 167, 44, 0.10), transparent 60%),
                var(--night-2);
            text-align: center;
            padding: 4.5rem 1rem 5rem;
        }
        .count-state[hidden] { display: none; }
        .count-title {
            font-family: var(--font-poster);
            font-size: clamp(1.5rem, 4.5vw, 2.4rem);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--cream);
        }
        .count-title em { color: var(--gold); font-style: normal; }
        .count-grid {
            display: flex;
            justify-content: center;
            gap: clamp(0.6rem, 2.5vw, 1.4rem);
            margin-top: 2.2rem;
        }
        .tile {
            background: var(--panel);
            border: 2px solid var(--line);
            border-radius: 10px;
            padding: clamp(0.7rem, 2.5vw, 1.2rem) clamp(0.8rem, 3vw, 1.6rem);
            min-width: clamp(4.4rem, 18vw, 7.5rem);
            box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.06), 0 10px 26px rgba(0, 0, 0, 0.45);
        }
        .tile .num {
            font-family: var(--font-poster);
            font-size: clamp(2.4rem, 9vw, 4.6rem);
            line-height: 1;
            color: var(--gold-soft);
            font-variant-numeric: tabular-nums;
        }
        .tile .unit {
            font-family: var(--font-poster);
            letter-spacing: 0.22em;
            font-size: clamp(0.7rem, 2vw, 0.95rem);
            color: var(--cream-dim);
            text-transform: uppercase;
            margin-top: 0.4rem;
        }
        .count-sub { margin-top: 1.8rem; color: var(--cream-dim); font-size: 1.05rem; }

        .now-badge {
            display: inline-block;
            font-family: var(--font-display);
            font-size: clamp(2.2rem, 7vw, 4rem);
            color: var(--gold-soft);
            text-shadow: 2px 2px 0 var(--red), 4px 4px 0 rgba(0, 0, 0, 0.4);
            animation: glow-pulse 1.6s ease-in-out infinite;
        }
        @keyframes glow-pulse {
            0%, 100% { filter: drop-shadow(0 0 6px rgba(240, 167, 44, 0.35)); }
            50% { filter: drop-shadow(0 0 20px rgba(240, 167, 44, 0.75)); }
        }
        .now-lines {
            margin-top: 1.4rem;
            font-family: var(--font-poster);
            font-size: clamp(1.2rem, 3.5vw, 1.7rem);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .now-lines span { color: var(--gold); }
        .count-state .btn { margin-top: 2rem; }

        /* =========== WHAT TO EXPECT =========== */
        .expect {
            background: var(--cream);
            color: var(--night);
            padding: 5rem 0 5.5rem;
            background-image:
                radial-gradient(rgba(200, 16, 46, 0.05) 1.5px, transparent 1.5px);
            background-size: 26px 26px;
        }
        .expect-head { text-align: center; max-width: 46rem; margin-inline: auto; }
        .expect-head .eyebrow { color: var(--red); }
        .expect-head h2 {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: clamp(2rem, 6vw, 3.2rem);
            margin-top: 0.6rem;
        }
        .expect-head p { margin-top: 1rem; color: #4d4237; }
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 1.4rem;
            margin-top: 3rem;
        }
        .card {
            position: relative;
            background: #fffaf0;
            border: 2px solid rgba(23, 16, 9, 0.14);
            border-radius: 14px;
            padding: 1.8rem 1.5rem 1.6rem;
            box-shadow: 0 6px 18px rgba(23, 16, 9, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .card:hover { transform: translateY(-6px) rotate(-0.5deg); box-shadow: 0 14px 26px rgba(23, 16, 9, 0.16); }
        .card .icon {
            display: inline-grid;
            place-items: center;
            width: 3.2rem;
            height: 3.2rem;
            border-radius: 50%;
            background: var(--red);
            color: var(--cream);
            box-shadow: 3px 3px 0 var(--gold);
            margin-bottom: 1rem;
        }
        .card h3 {
            font-family: var(--font-poster);
            font-size: 1.35rem;
            letter-spacing: 0.08em;
        }
        .card p { margin-top: 0.4rem; color: #4d4237; font-size: 0.98rem; }

        /* =========== RAFFLE =========== */
        .raffle {
            position: relative;
            background:
                radial-gradient(ellipse at 85% 10%, rgba(200, 16, 46, 0.16), transparent 55%),
                var(--night);
            padding: 5rem 0 5.5rem;
        }
        .raffle-head { text-align: center; max-width: 48rem; margin-inline: auto; }
        .raffle-head h2 {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: clamp(2.1rem, 6.5vw, 3.4rem);
            color: var(--cream);
            text-shadow: 2px 2px 0 var(--red);
            margin-top: 0.6rem;
        }
        .raffle-head p { margin-top: 1rem; color: var(--cream-dim); }
        .raffle-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 2.5rem;
            align-items: center;
            margin-top: 3rem;
        }
        .raffle-panel {
            background: #fffaf0;
            color: var(--night);
            border-radius: 16px;
            padding: 1.6rem;
            box-shadow: 0 18px 44px rgba(0, 0, 0, 0.55);
            transform: rotate(-1deg);
        }
        .raffle-panel .promo-img { border-radius: 8px; }
        .prize-list { list-style: none; margin-top: 1.4rem; }
        .prize-list li {
            display: flex;
            gap: 0.9rem;
            align-items: baseline;
            padding: 0.65rem 0.2rem;
        }
        .prize-list li + li { border-top: 2px dashed rgba(23, 16, 9, 0.18); }
        .prize-rank {
            flex-shrink: 0;
            font-family: var(--font-poster);
            font-size: 1.2rem;
            letter-spacing: 0.06em;
            color: var(--red);
            min-width: 3.4rem;
        }
        .prize-what { font-weight: 600; }
        .prize-what small { display: block; font-weight: 400; color: #4d4237; }
        .raffle-side { text-align: center; }
        .raffle-photo {
            border: 6px solid var(--cream);
            border-radius: 6px;
            transform: rotate(2deg);
            box-shadow: 0 16px 38px rgba(0, 0, 0, 0.55);
        }
        .raffle-photo img {
            border-radius: 2px;
            width: 100%;
            height: auto;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            object-position: center 58%;
        }
        .raffle-facts {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.7rem;
            margin-top: 1.8rem;
        }
        .fact {
            font-family: var(--font-poster);
            letter-spacing: 0.08em;
            font-size: 1rem;
            color: var(--gold-soft);
            border: 2px solid var(--line);
            border-radius: 999px;
            padding: 0.35rem 1rem;
        }
        .raffle-side .btn { margin-top: 2rem; }
        .raffle-side .raffle-fb-cta .btn { margin-top: 0.9rem; }
        .raffle-note { margin-top: 1rem; color: var(--cream-dim); font-size: 0.95rem; font-style: italic; }

        /* =========== SUPPORT / FOOTER =========== */
        .support { background: var(--night-2); padding: 5rem 0 3rem; }
        .support-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            align-items: center;
        }
        .support-img {
            border-radius: 14px;
            border: 2px solid var(--line);
            box-shadow: 0 16px 38px rgba(0, 0, 0, 0.5);
        }
        .support-img img {
            border-radius: 12px;
            width: 100%;
            height: auto;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            object-position: center 42%;
        }
        .support h2 {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: clamp(1.9rem, 5vw, 2.8rem);
            margin-top: 0.6rem;
        }
        .support p { margin-top: 1rem; color: var(--cream-dim); }
        .support .btn { margin-top: 1.8rem; }
        .foot {
            margin-top: 4rem;
            border-top: 1px solid rgba(240, 167, 44, 0.16);
            padding-top: 1.6rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.4rem 1.6rem;
            text-align: center;
            color: var(--cream-dim);
            font-size: 0.92rem;
        }

        @media (max-width: 820px) {
            .raffle-grid, .support-grid { grid-template-columns: 1fr; }
            .support-grid .support-img { order: -1; }
            .raffle-panel, .raffle-photo, .date-ticket { transform: none; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation: none !important; transition: none !important; }
            [data-reveal] { opacity: 1; transform: none; }
            html { scroll-behavior: auto; }
        }
    </style>
</head>
<body>

    <!-- =========== HERO =========== -->
    <header class="hero">
        <Image src={carnivalImage} alt="" class="hero-bg" widths={[800, 1200, 1920]} sizes="100vw" loading="eager" />
        <div class="hero-inner">
            <span class="eyebrow">Easton Volunteer Fire Company #1 presents</span>
            <h1>Annual Carnival</h1>
            <div class="hero-year">2026</div>
            <div class="date-ticket">
                <div class="dt-days">Tue July 28 — Sat Aug 1</div>
                <div class="dt-hours"><Clock size={18} aria-hidden="true" /> 6:00 – 11:00 PM Nightly</div>
            </div>
            <p class="hero-place"><MapPin size={18} aria-hidden="true" /> {siteConfig.Socials.Location}</p>
            <div class="hero-ctas">
                <a class="btn btn-red" href="#raffle"><Ticket size={20} aria-hidden="true" /> Jeep Raffle Tickets</a>
                <a class="btn btn-ghost" href="#expect">What's at the Carnival</a>
            </div>
        </div>
    </header>

    <div class="bulbs" aria-hidden="true"></div>

    <!-- =========== COUNTDOWN =========== -->
    <section class="countdown" aria-label="Carnival countdown">
        <div class="wrap">
            <div class="count-state" data-state="before">
                <h2 class="count-title">The fun begins in<em>…</em></h2>
                <div class="count-grid" role="timer">
                    <div class="tile"><div class="num" data-num="days">–</div><div class="unit">Days</div></div>
                    <div class="tile"><div class="num" data-num="hours">–</div><div class="unit">Hours</div></div>
                    <div class="tile"><div class="num" data-num="mins">–</div><div class="unit">Minutes</div></div>
                    <div class="tile"><div class="num" data-num="secs">–</div><div class="unit">Seconds</div></div>
                </div>
                <p class="count-sub">Gates open Tuesday, July 28 at 6:00 PM — see you there!</p>
            </div>

            <div class="count-state" data-state="during" hidden>
                <span class="now-badge">It's Carnival Week!</span>
                <div class="now-lines">
                    Open tonight <span>6 – 11 PM</span><br />
                    Now through <span>Saturday, August 1</span>
                </div>
                <a class="btn btn-red" href="#raffle"><Ticket size={20} aria-hidden="true" /> Get Raffle Tickets</a>
            </div>

            <div class="count-state" data-state="after" hidden>
                <span class="now-badge">That's a wrap!</span>
                <div class="now-lines">
                    Thanks for a great week, Easton —<br />
                    <span>see you next summer!</span>
                </div>
            </div>
        </div>
    </section>

    <!-- =========== WHAT TO EXPECT =========== -->
    <section class="expect" id="expect">
        <div class="wrap">
            <div class="expect-head" data-reveal>
                <span class="eyebrow">What to Expect</span>
                <h2>Family Fun for Everyone</h2>
                <p>Five nights of rides, games, bingo, and delicious food — a beloved Easton tradition that brings the whole community together.</p>
            </div>
            <div class="cards">
                {features.map((feature) => (
                    <div class="card" data-reveal>
                        <span class="icon"><feature.icon size={26} aria-hidden="true" /></span>
                        <h3>{feature.title}</h3>
                        <p>{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <div class="bulbs" aria-hidden="true"></div>

    <!-- =========== RAFFLE =========== -->
    <section class="raffle" id="raffle">
        <div class="wrap">
            <div class="raffle-head" data-reveal>
                <span class="eyebrow">Annual Fundraiser</span>
                <h2>The 2026 Jeep Raffle</h2>
                <p>Our biggest raffle of the year — three chances to win, and every ticket supports your local volunteer fire company.</p>
            </div>
            <div class="raffle-grid">
                <div class="raffle-panel" data-reveal>
                    <Image src={rafflePromo} alt="Raffle tickets on sale: 2026 Jeep Grand Cherokee L Summit and 2026 Jeep Wrangler Rubicon" class="promo-img" widths={[600, 1200]} sizes="(max-width: 820px) 92vw, 600px" />
                    <ul class="prize-list">
                        <li>
                            <span class="prize-rank">1st</span>
                            <span class="prize-what">Your choice of a 2026 Jeep Grand Cherokee L Summit <em>or</em> 2026 Jeep Wrangler Rubicon</span>
                        </li>
                        <li>
                            <span class="prize-rank">2nd</span>
                            <span class="prize-what">$500 Amazon gift card</span>
                        </li>
                        <li>
                            <span class="prize-rank">3rd</span>
                            <span class="prize-what">$250 Amazon gift card</span>
                        </li>
                    </ul>
                </div>
                <div class="raffle-side" data-reveal>
                    <div class="raffle-photo">
                        <Image src={raffleTicketsPhoto} alt="Easton Fire Department helmet with Jeep raffle tickets fanned out in front of a fire engine" widths={[500, 900]} sizes="(max-width: 820px) 92vw, 450px" />
                    </div>
                    <div class="raffle-facts">
                        <span class="fact">$25 per ticket</span>
                        <span class="fact">Drawing Sat, Aug 1 · 10:30 PM</span>
                        <span class="fact">Live-streamed</span>
                    </div>
                    <a class="btn btn-red" href={raffleUrl} target="_blank" rel="noopener"><Ticket size={20} aria-hidden="true" /> Buy Tickets Online</a>
                    <div class="raffle-fb-cta">
                        <a class="btn btn-ghost" href={siteConfig.Socials.Facebook} target="_blank" rel="noopener"><Facebook size={20} aria-hidden="true" /> Live Updates on Facebook</a>
                    </div>
                    <p class="raffle-note">Winner need not be present to win.</p>
                </div>
            </div>
        </div>
    </section>

    <div class="bulbs" aria-hidden="true"></div>

    <!-- =========== SUPPORT / FOOTER =========== -->
    <footer class="support">
        <div class="wrap">
            <div class="support-grid">
                <div data-reveal>
                    <span class="eyebrow">Why It Matters</span>
                    <h2>Every Ride Supports Easton</h2>
                    <p>The Annual Carnival is our largest fundraiser of the year. Proceeds support the fire company's operations, equipment purchases, and training programs — helping our volunteers protect Easton around the clock.</p>
                    <p>For the latest announcements, entertainment schedules, and carnival news, follow us on Facebook.</p>
                    <a class="btn btn-ghost" href={siteConfig.Socials.Facebook} target="_blank" rel="noopener"><Facebook size={20} aria-hidden="true" /> Follow us on Facebook</a>
                </div>
                <div class="support-img" data-reveal>
                    <Image src={pirateShipImage} alt="The pirate ship ride at the Easton carnival" widths={[600, 1000]} sizes="(max-width: 820px) 92vw, 520px" />
                </div>
            </div>
            <div class="foot">
                <span>{siteConfig.companyName}</span>
                <span>{siteConfig.Socials.Location}</span>
                <span>{siteConfig.Socials.Phone}</span>
                <span>© {new Date().getFullYear()}</span>
            </div>
        </div>
    </footer>

    <script>
        document.documentElement.classList.add('js');

        // Carnival schedule: opens Tue Jul 28 6:00 PM EDT, final night ends Sat Aug 1 11:00 PM EDT.
        const CARNIVAL_START = new Date('2026-07-28T18:00:00-04:00').getTime();
        const CARNIVAL_END = new Date('2026-08-01T23:00:00-04:00').getTime();

        const states = document.querySelectorAll<HTMLElement>('.count-state');
        const nums = {
            days: document.querySelector('[data-num="days"]'),
            hours: document.querySelector('[data-num="hours"]'),
            mins: document.querySelector('[data-num="mins"]'),
            secs: document.querySelector('[data-num="secs"]'),
        };

        function show(name: string) {
            states.forEach((s) => s.toggleAttribute('hidden', s.dataset.state !== name));
        }

        let timer: ReturnType<typeof setInterval> | undefined;

        function tick() {
            const now = Date.now();
            if (now < CARNIVAL_START) {
                const diff = CARNIVAL_START - now;
                const pad = (n: number) => String(n).padStart(2, '0');
                if (nums.days) nums.days.textContent = String(Math.floor(diff / 86400000));
                if (nums.hours) nums.hours.textContent = pad(Math.floor(diff / 3600000) % 24);
                if (nums.mins) nums.mins.textContent = pad(Math.floor(diff / 60000) % 60);
                if (nums.secs) nums.secs.textContent = pad(Math.floor(diff / 1000) % 60);
                show('before');
            } else if (now <= CARNIVAL_END) {
                show('during');
            } else {
                show('after');
                if (timer) clearInterval(timer);
            }
        }

        tick();
        timer = setInterval(tick, 1000);

        // Gentle scroll reveals
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in');
                        io.unobserve(entry.target);
                    }
                });
            },
            { threshold: 0.15 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
</body>
</html>
